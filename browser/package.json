{
  "name": "aql-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build aql-stylings --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "test:ci": "ng test --no-watch --browsers=ChromeHeadless --code-coverage",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json}\" \"projects/**/*.{ts,html,scss,css,json}\"",
    "reorder": "node scripts/reorder-members.js",
    "check-translations": "node scripts/check-translations.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.2",
    "@angular/cdk": "20.2.14",
    "@angular/common": "21.2.2",
    "@angular/compiler": "21.2.2",
    "@angular/core": "21.2.2",
    "@angular/forms": "21.2.2",
    "@angular/platform-browser": "21.2.2",
    "@angular/platform-browser-dynamic": "21.2.2",
    "@angular/router": "21.2.2",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "echarts": "^6.1.0",
    "istanbul-lib-instrument": "^6.0.3",
    "rxjs": "7.8.2",
    "tslib": "^2.3.0",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.1",
    "@angular/cli": "21.2.1",
    "@angular/compiler-cli": "21.2.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jasmine": "5.1.15",
    "angular-eslint": "20.6.0",
    "autoprefixer": "^10.5.4",
    "bootstrap-icons": "^1.13.1",
    "daisyui": "^5.7.22",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jasmine-core": "5.2.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "ng-packagr": "21.2.0",
    "postcss": "^8.5.14",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^27.0.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
